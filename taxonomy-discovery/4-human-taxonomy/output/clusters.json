{
  "method": "4-human-taxonomy",
  "n_items": 285,
  "params": {
    "taxonomy": "taxonomy.yaml",
    "model": "claude-opus-5-5"
  },
  "categories": [
    {
      "id": "c1",
      "name": "Pre-training and post-training: personas, character and psychology",
      "description": "Shaping or studying the model's persona, character, values and psychology through pre-training and post-training (data, fine-tuning, alignment training), including how training generalises to the model's character.",
      "parent": null
    },
    {
      "id": "c2",
      "name": "RL safety",
      "description": "Doing reinforcement learning (e.g. RLVR, now central to post-training) properly and safely: reward hacking, specification gaming, and how to do RL without damaging the model's character or alignment.",
      "parent": null
    },
    {
      "id": "c3",
      "name": "AI control and monitoring",
      "description": "Not training or influencing the model's behaviour. Instead, assume the model is potentially misaligned and monitor or constrain its behaviour during inference in production.",
      "parent": null
    },
    {
      "id": "c3.1",
      "name": "Chain-of-thought monitoring",
      "description": "Monitoring models through their reasoning: whether chain of thought stays faithful, legible and monitorable, and how much models can reason without it.",
      "parent": "c3"
    },
    {
      "id": "c3.2",
      "name": "AI control methods",
      "description": "Control protocols, settings and monitors that keep a possibly misaligned model from causing harm, including attack policies and red-teaming of the protocols.",
      "parent": "c3"
    },
    {
      "id": "c4",
      "name": "Interpretability",
      "description": "Improving our understanding of model internals to yield insights about any aspect of models, or to develop new white-box alignment, monitoring or control techniques.",
      "parent": null
    },
    {
      "id": "c5",
      "name": "Frontier misalignment incidents",
      "description": "Studying real misalignment incidents (such as the Hugging Face attack) for insights into model behaviour, which safety techniques are and aren't effective, and how to build an effective safety culture at labs.",
      "parent": null
    },
    {
      "id": "c6",
      "name": "Agent foundations and alignment strategy",
      "description": "Theoretical foundations of agency and alignment, and strategy for the alignment field.",
      "parent": null
    },
    {
      "id": "c7",
      "name": "Misuse and dangerous capabilities",
      "description": "Measuring capabilities that could enable misuse or catastrophe (CBRN, cyber, persuasion, autonomy, AI R&D) and defending against misuse by people: jailbreaks, safeguard classifiers, red-teaming and model safety reports.",
      "parent": null
    },
    {
      "id": "c8",
      "name": "Evaluations and auditing",
      "description": "Measuring whether a model is aligned rather than changing it: propensity evaluations for scheming and sabotage, evaluation awareness, sandbagging, alignment auditing, and honesty and lie detection.",
      "parent": null
    }
  ],
